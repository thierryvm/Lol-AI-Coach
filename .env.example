# ==============================================================================
# LoL AI Coach - Configuration des variables d'environnement (.env)
# Copiez ce fichier en ".env" à la racine du projet : cp .env.example .env
# ==============================================================================

# GEMINI_API_KEY : Clé API Gemini pour le coaching tactique IA (plans de match, post-game, live).
# Créez une clé gratuite sur : https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RIOT_API_KEY : Clé serveur Riot Games (Account-V1, Summoner-V4, League-V4, Match-V5, Spectator-V5).
# Obtenez votre clé (RGAPI-...) sur : https://developer.riotgames.com/
RIOT_API_KEY="MY_RIOT_API_KEY"

# PORT : Port d'écoute du serveur local (3000 par défaut).
PORT=3000

# APP_URL : Optionnel en local (injecté automatiquement sur Cloud Run / AI Studio).
APP_URL="http://localhost:3000"
