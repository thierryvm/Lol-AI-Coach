# ==============================================================================
# LoL AI Coach - Configuration des variables d'environnement (.env)
# Copiez ce fichier en ".env" à la racine du projet : cp .env.example .env
# ==============================================================================

# RIOT_API_KEY : Clé serveur Riot Games (Account-V1, Summoner-V4, League-V4, Match-V5, Spectator-V5).
# Obtenez votre clé (RGAPI-...) sur : https://developer.riotgames.com/
RIOT_API_KEY="MY_RIOT_API_KEY"

# ------------------------------------------------------------------------------
# Fournisseurs IA (configurez au moins un fournisseur selon votre abonnement)
# ------------------------------------------------------------------------------

# GEMINI_API_KEY : Clé API Google Gemini (moteur par défaut + Google Search Grounding).
# Créez une clé sur : https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY : Optionnel - API directe Anthropic Claude (Claude Sonnet 4.5, Opus, Haiku).
# Note : Si vous utilisez un abonnement Claude Pro/Max en local via Claude Code CLI (`claude login`),
# aucune clé ANTHROPIC_API_KEY n'est nécessaire lorsque l'application tourne sur votre PC.
# ANTHROPIC_API_KEY="sk-ant-..."

# OPENAI_API_KEY : Optionnel - API directe OpenAI (GPT-4.1, GPT-4.1-mini, GPT-4o, o4-mini).
# OPENAI_API_KEY="sk-..."

# OPENROUTER_API_KEY : Optionnel - Accès unifié OpenRouter (Claude, GPT, DeepSeek, Llama...).
# OPENROUTER_API_KEY="sk-or-..."

# MISTRAL_API_KEY : Optionnel - API Mistral AI.
# MISTRAL_API_KEY=""

# GROQ_API_KEY : Optionnel - API Groq (inférence ultra-rapide).
# GROQ_API_KEY="gsk_..."

# DEEPSEEK_API_KEY : Optionnel - API DeepSeek.
# DEEPSEEK_API_KEY=""

# Serveur IA local ou compatible OpenAI (ex: Ollama, LM Studio, LiteLLM, vLLM)
# CUSTOM_AI_BASE_URL="http://127.0.0.1:11434/v1"
# CUSTOM_AI_API_KEY=""

# PORT : Port d'écoute du serveur local (3000 par défaut).
PORT=3000

# APP_URL : Optionnel en local (injecté automatiquement sur Cloud Run / AI Studio).
APP_URL="http://localhost:3000"
